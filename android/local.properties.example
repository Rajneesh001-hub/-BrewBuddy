# BrewBuddy — Local Properties Example
# Copy this file to local.properties and add your actual Google Maps API key

# Google Maps API Key (required for Store Locator)
# Get your key from: https://console.cloud.google.com/google/maps-apis
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Flutter SDK path (auto-generated by flutter create)
sdk.dir=/path/to/flutter/sdk
flutter.sdk=/path/to/flutter
